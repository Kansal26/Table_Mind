# Supabase: copy the project URL and API keys from Project Settings > API Keys.
# Use the publishable key for both public-key variable names below.
# Public by design: VITE_ variables are included in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Server-only secret key (keeps the legacy variable name; never add a VITE_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# Public by design: Razorpay key ID is used by the browser checkout.
VITE_RAZORPAY_KEY_ID=

# Server-only secrets: never prefix these variables with VITE_.
RAZORPAY_KEY_SECRET=
GROQ_API_KEY=
GEMINI_API_KEY=
RESEND_API_KEY=

# Server-side notification recipient (not a secret).
RESTAURANT_NOTIFICATION_EMAIL=

# Public app URL configuration.
VITE_APP_URL=
PUBLIC_URL=
